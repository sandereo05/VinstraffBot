# Notion internal integration secret (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxx
# 32-char ID from the database URL
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-xxx
# App-Level Token with connections:write scope (Basic Information)
SLACK_APP_TOKEN=xapp-xxx

# Optional, defaults to 5
# NOTION_CACHE_TTL_MINUTES=5
